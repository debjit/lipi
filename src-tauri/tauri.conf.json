{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lipi",
  "version": "0.1.5-4",
  "identifier": "com.lipi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lipi",
        "width": 960,
        "height": 700,
        "minWidth": 90,
        "minHeight": 40,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Debjit Biswas",
    "homepage": "https://lipi.debjit.in",
    "copyright": "Copyright © 2026 Debjit Biswas",
    "category": "Productivity",
    "shortDescription": "Local voice dictation and notes",
    "longDescription": "Lipi is a local-first voice dictation app. Press Alt+R, speak, and paste the transcript into any window.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libxdo3"]
      },
      "rpm": {
        "depends": ["libXdo"]
      }
    }
  }
}
